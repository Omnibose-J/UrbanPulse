# Copy to .env at the repo root. Names only; never commit values.
# Seoul Open Data Plaza key (실시간 도시데이터 citydata)
SEOUL_API_KEY=
# data.go.kr key approved for 한국천문연구원 특일 정보 (SpcdeInfoService)
KASI_API_KEY=
# Postgres URL. Local: the "DB URL" printed by `supabase start` (app/)
DATABASE_URL=
# Supabase API URL and service-role key. Local: printed by `supabase start`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local folder, or gs://<bucket>/<prefix> (objects are write-once)
RAW_DIR=data/raw
# Optional path read instead of this file. ENGINE_SKIP_DOTENV=1 still wins.
ENGINE_ENV_FILE=
# Token protecting /admin/eval
ADMIN_TOKEN=
# Weekend reminder (web push). Generate once: npx web-push generate-vapid-keys. The public key is also NEXT_PUBLIC_*
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Shared with Vercel Cron; the Friday route accepts only `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Public origin for metadata, the sitemap and push links (no trailing slash). Local: http://localhost:3000
SITE_URL=
